# arena-bridge skill — configuration (copy values into ~/.arena-bridge/.env)
# install.sh creates this file for you with generated keys.

# Where credentials/sessions live
DATA_DIR=$HOME/.arena-bridge

# Server binding (keep 127.0.0.1 unless you proxy deliberately)
HOST=127.0.0.1
PORT=20140

# Bearer key required on every /v1/chat/completions request (REQUIRED)
# Generate: openssl rand -hex 24
ARENA_AGENT_BRIDGE_KEY=

# Optional proxy (leave empty for direct connection)
# ARENA_AGENT_PROXY=socks5://127.0.0.1:40000

# Optional: explicit chromium path
# ARENA_AGENT_CHROME=/path/to/chrome

# Session TTL (ms) — default 12h
ARENA_SESSION_TTL_MS=43200000

# Refresh margin: re-login when cookie expires within this many seconds
ARENA_REFRESH_MARGIN_SEC=1200

# Rate limit (req/min)
ARENA_RATE_LIMIT_RPM=100

# Max parallel tool calls per turn
ARENA_MAX_TOOL_CALLS=8

# Encryption key for stored credentials (auto-generated by install.sh)
STORAGE_ENCRYPTION_KEY=

# Optional Local MCP. The self-built Node runtime is the default; no AgentDock
# installation is required. Supply one existing absolute workspace here or in
# the GUI startup input. File tools deny DATA_DIR even inside the workspace.
# ARENA_MCP_RUNTIME=local
# ARENA_MCP_WORKSPACE=/home/me/project
# ARENA_LOCAL_MCP_PORT=8765
#
# Remote Arena needs a public transport in addition to the loopback listener.
# Opt in with an already-installed open-source cloudflared executable's
# absolute path (nothing is downloaded). Unset = local-only, no injection.
# ARENA_CLOUDFLARED_PATH=/usr/local/bin/cloudflared
#
# Legacy optional compatibility only (agentdock.exe + cloudflared.exe in this
# explicitly supplied directory); no Downloads/install auto-detection.
# ARENA_MCP_RUNTIME=agentdock
# ARENA_AGENTDOCK_DIR=C:\tools\AgentDock

# Optional: extra directories the local agent may READ but never write
# (typically global agent skills). Absolute paths, platform delimiter
# separated (POSIX ":" / Windows ";"), must not overlap the workspace.
# Unset = no read-only roots.
# ARENA_SKILL_ROOTS=/home/me/.workbuddy/skills:/home/me/shared-prompts
